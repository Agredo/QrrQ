    given-names: Christian
    alias: Agredo
version: 1.0.0
date-released: 2026-11-25
license: MIT
url: https://github.com/Agredo/QrrQ
repository-code: https://github.com/Agredo/QrrQ
keywords:
  - QR-Code
  - Spiegelung
  - Reed-Solomon
  - Fehlerkorrektur
  - Steganographie
