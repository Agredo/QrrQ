<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>QrrQ</PackageId>
    <Title>QrrQ – QR-Codes mit Spiegel-Geheimnis</Title>
    <Version>1.0.0</Version>
    <Description>Erzeugt QR-Codes mit zwei Inhalten: normal gescannt liefert der Code Text A, im Spiegel einen ebenso gültigen Text B. Beide Richtungen sind vollständige QR-Codes nach ISO/IEC 18004 mit voller Reed-Solomon-Fehlerkorrektur. Ohne Laufzeitabhängigkeiten: eigener Encoder und Decoder, Ausgabe als PNG, SVG, Modulraster oder Konsolenvorschau.</Description>
    <PackageTags>qr;qrcode;mirror;spiegel;escape-room;puzzle;steganography;reed-solomon;error-correction;gf256;svg;png</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>QrrQ</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
