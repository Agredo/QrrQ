<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>QrrQ.Cli</RootNamespace>
    <!-- The assembly stays QrrQ.Cli: an AssemblyName "qrrq" would collide with QrrQ.dll on Windows -->
    <!-- installable as a .NET tool: dotnet tool install -g QrrQ.Cli -> command "qrrq" -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>qrrq</ToolCommandName>
    <PackageId>QrrQ.Cli</PackageId>
    <Title>QrrQ.Cli – Spiegel-QR-Codes auf der Kommandozeile</Title>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>Kommandozeile für QrrQ: erzeugt QR-Codes, die normal gescannt einen Text und gespiegelt einen zweiten zeigen – als PNG und SVG, inklusive eingebautem Selbsttest. Installation: dotnet tool install -g QrrQ.Cli, Aufruf: qrrq "normal" "gespiegelt".</Description>
    <PackageTags>qr;qrcode;mirror;spiegel;escape-room;puzzle;dotnet-tool;cli;svg;png</PackageTags>
  </PropertyGroup>

  <!--
    Native AOT: dotnet publish src/QrrQ.Cli -c Release -r <rid> -p:PublishAot=true
    The switches below only apply to that publish and make the binary smaller.
    As a .NET tool the package stays framework-dependent (AOT binaries are in the release).
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>true</PredefinedCulturesOnly>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>
    <IlcDisableReflection>true</IlcDisableReflection>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetricsSupport>false</MetricsSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <EnableUnsafeXslt>false</EnableUnsafeXslt>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <NativeDebugSymbols>false</NativeDebugSymbols>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../QrrQ/QrrQ.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
